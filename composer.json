{
  "name": "christianbayer/pixl-sql-tracker",
  "description": "Self-hosted PHP/MySQL analytics tracker with bot-aware dashboard and browser notifications.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "maxmind-db/reader": "^1.13"
  },
  "scripts": {
    "test-live": "php tests/live_test.php",
    "test-useragents": "php tests/useragents_test.php",
    "test-export": "php tests/stats_export_test.php",
    "test-export-model": "node tests/export_model_test.js",
    "test-storage": "php tests/storage_migration_test.php",
    "test-setup": "php tests/setup_check_test.php",
    "test-reading-score": "php tests/reading_score_test.php",
    "test-pushover": "php tests/pushover_test.php",
    "test-captcha": [
      "php tests/captcha_test.php",
      "node tests/captcha_client_test.js"
    ],
    "lint": [
      "php -l pixl_server.php",
      "php -l pixl_collect.php",
      "php -l pixl_pushover.php",
      "php -l configurator.php",
      "php -l captcha.php",
      "php -l pixl_captcha.php",
      "php -l pixl_stats.php",
      "php -l pixel_stats2.php",
      "php -l pixl_setup_check.php",
      "php -l pixl_config.example.php",
      "php -l pixl_config.ionos.example.php",
      "php -l ppcmate-postback.php",
      "php -l utm.php",
      "php -l live.php",
      "php -l live_data.php",
      "php -l useragents_data.php",
      "php -l useragents_view.php",
      "php -l stats.php",
      "php -l stats_export.php",
      "php -l export.php",
      "php -l export_view.php",
      "node --check export_model.js",
      "node --check export.js",
      "node --check useragents.js",
      "node --check live.js",
      "php -l stat/impression.php",
      "php -l tools/migrate_storage_to_mysql.php",
      "php -l stat4/api.php",
      "php -l stat4/auth.php",
      "php -l stat4/collect.php",
      "php -l stat4/config.php",
      "php -l stat4/configurator.php",
      "php -l stat4/db.php",
      "php -l stat4/index.php",
      "php -l stat4/login.php",
      "php -l stat4/logout.php",
      "php -l stat4/pushover.php",
      "php -l stat4/reset.php",
      "php -l stat4/systemcheck.php",
      "node --check pixel_webpush_sw.js",
      "node --check pixl77.js",
      "node --check count.js",
      "node --check captcha.js",
      "php -l configurator2.php",
      "node --check stat4/count.js",
      "node --check stat4/dashboard.js"
    ],
    "test-client": [
      "node tests/count_runtime_test.js",
      "node tests/stat4_runtime_test.js",
      "STAT4_SOURCE=count.js node tests/stat4_runtime_test.js",
      "node tests/stat4_dashboard_test.js",
      "node tests/captcha_client_test.js"
    ],
    "test-http": "node tests/configurator2_http_test.js",
    "test-backend": "php tests/backend_regression_test.php",
    "test-browser": [
      "node tests/count_external_browser_test.js",
      "node tests/captcha_csp_browser_test.js"
    ],
    "test-captcha-http": "node tests/captcha_http_test.js"
  }
}
